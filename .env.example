# Copy to .env . Every value has a working default, so the app runs with none of them.

# --- Nokia Network as Code -------------------------------------------------
# simulator : no credentials, deterministic CAMARA-shaped answers (default)
# live      : real calls to the Nokia gateway
# hybrid    : live where possible, simulator fallback per call
NAC_MODE=simulator
NAC_RAPIDAPI_KEY=
# true targets the sandbox hosts that answer for simulator MSISDNs
NAC_DEV_MODE=true
NAC_TIMEOUT_S=12

# --- AI agent layer --------------------------------------------------------
# The Gemini planner is opt-in and needs BOTH of these: a key alone leaves the
# deterministic policy planner in charge, on purpose, so nothing starts
# spending on a model because a key happened to be in the environment.
#   policy : deterministic escalation ladder (default, offline, what CI asserts)
#   gemini : Pydantic AI typed planning over the CAMARA tool registry
AGENT_PROVIDER=policy
GEMINI_API_KEY=
# Google AI Studio retires model ids. If this one ever 404s, list the live
# ones and set another; gemini-flash-latest always resolves but is busier.
AGENT_MODEL=gemini-3.5-flash
AGENT_TEMPERATURE=0.1
AGENT_MAX_STEPS=8

# --- App -------------------------------------------------------------------
DB_PATH=data/ledger.db
PORT=8000
